# Server
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=dbpassword
DB_NAME=dbname

# JWT 
# Generate one with: openssl rand -hex 32
JWT_SECRET=jwtsecret

# AWS
AWS_REGION=region
AWS_ACCESS_KEY_ID=accesskeyid
AWS_SECRET_ACCESS_KEY=accesskey
S3_BUCKET=s3bucketname

# Processor
# PROCESSOR_WORKERS: number of concurrent PDF→audio workers.
# Start with 3. Each worker holds one DB connection while processing,
# so keep this well below DB_MAX_OPEN_CONNS (which defaults to 25 in db.go).
PROCESSOR_WORKERS=3

# PROCESSOR_POLL_SECS: how many seconds a worker sleeps when the queue
# is empty before checking again. 5 seconds is a good balance between
# low latency and unnecessary DB load.
PROCESSOR_POLL_SECS=5

# ELEVEN LABS
ELEVENLABS_API_KEY=apikey
ELEVENLABS_VOICE_A=voiceid
ELEVENLABS_VOICE_B=voiceid

#GROQ
GROQ_API_KEY=apikey

#RENDER
DATABASE_URL=postgresql://yourname:XXXXXX/webservicename
EXTERNAL_URL=postgresql://yourname:XXXXXX/webservicename